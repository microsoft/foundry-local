# Run after final signing as well as for unsigned development outputs. File hashes cover the final packaged bytes.
# Supplying only OUTPUT_FILE refreshes signed payload hashes while retaining the original build identity.
if(DEFINED OUTPUT_FILE AND EXISTS "${OUTPUT_FILE}")
    if(NOT DEFINED NATIVE_FILE OR NOT DEFINED HOST_FILE OR NOT DEFINED NATIVE_BUILD OR NOT DEFINED RID)
        file(READ "${OUTPUT_FILE}" previous_manifest)
        get_filename_component(manifest_dir "${OUTPUT_FILE}" DIRECTORY)
        if(NOT DEFINED NATIVE_FILE)
            string(JSON native_name GET "${previous_manifest}" native file_name)
            set(NATIVE_FILE "${manifest_dir}/${native_name}")
        endif()
        if(NOT DEFINED HOST_FILE)
            string(JSON host_name GET "${previous_manifest}" host file_name)
            set(HOST_FILE "${manifest_dir}/${host_name}")
        endif()
        if(NOT DEFINED NATIVE_BUILD)
            string(JSON NATIVE_BUILD GET "${previous_manifest}" native_build)
        endif()
        if(NOT DEFINED RID)
            string(JSON RID GET "${previous_manifest}" rid)
        endif()
    endif()
endif()

foreach(required NATIVE_FILE HOST_FILE NATIVE_BUILD RID OUTPUT_FILE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing native runtime manifest input: ${required}")
    endif()
endforeach()

file(SHA256 "${NATIVE_FILE}" native_hash)
file(SHA256 "${HOST_FILE}" host_hash)
string(TOUPPER "${native_hash}" native_hash)
string(TOUPPER "${host_hash}" host_hash)
get_filename_component(native_name "${NATIVE_FILE}" NAME)
get_filename_component(host_name "${HOST_FILE}" NAME)
set(manifest "{\n")
string(APPEND manifest "  \"version\": 1,\n  \"protocol\": 1,\n")
string(APPEND manifest "  \"native_build\": \"${NATIVE_BUILD}\",\n  \"rid\": \"${RID}\",\n")
string(APPEND manifest "  \"native\": {\"file_name\": \"${native_name}\", \"sha256\": \"${native_hash}\"},\n")
string(APPEND manifest "  \"host\": {\"file_name\": \"${host_name}\", \"sha256\": \"${host_hash}\"}\n}\n")
file(WRITE "${OUTPUT_FILE}.tmp" "${manifest}")
file(RENAME "${OUTPUT_FILE}.tmp" "${OUTPUT_FILE}")
