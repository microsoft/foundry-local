{
  "name": "foundry-local",
  "version-semver": "0.1.0",
  "description": "Foundry Local C++ SDK",
  "builtin-baseline": "67e816ef4b11c01fa923a18d16ecf863216fda55",
  "dependencies": [
    {
      "name": "azure-core-cpp",
      "default-features": false,
      "features": [
        "curl"
      ],
      "platform": "!windows | uwp"
    },
    {
      "name": "azure-core-cpp",
      "default-features": false,
      "features": [
        "winhttp"
      ],
      "platform": "windows & !uwp"
    },
    "azure-storage-blobs-cpp",
    {
      "name": "libarchive",
      "default-features": false
    },
    "nlohmann-json",
    "jsoncons",
    "spdlog",
    "z4kn4fein-semver",
    "zlib"
  ],
  "features": {
    "service": {
      "description": "Build web service support (not available on Android)",
      "dependencies": [
        "oatpp"
      ]
    },
    "telemetry": {
      "description": "Build with 1DS (cpp-client-telemetry) telemetry uploads",
      "dependencies": [
        {
          "name": "cpp-client-telemetry",
          "default-features": false,
          "features": [
            "curl-openssl",
            "minimal-sqlite",
            "no-logging"
          ],
          "platform": "!uwp"
        }
      ]
    },
    "tests": {
      "description": "Build unit tests",
      "dependencies": [
        {
          "name": "cpp-httplib",
          "features": [
            "openssl"
          ]
        },
        "gtest"
      ]
    }
  },
  "overrides": [
    {
      "name": "cpp-client-telemetry",
      "version": "3.10.281.1"
    },
    {
      "name": "nlohmann-json",
      "version": "3.11.3"
    },
    {
      "name": "oatpp",
      "version": "1.3.0"
    }
  ]
}
