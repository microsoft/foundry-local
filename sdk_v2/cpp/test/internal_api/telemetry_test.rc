#include <winver.h>

1 VERSIONINFO
 FILEVERSION 1,2,3,4
 PRODUCTVERSION 5,6,7,8
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductVersion", "7.8.9"
            VALUE "FileVersion", "1.2.3.4"
        END
        BLOCK "040c04b0"
        BEGIN
            VALUE "CompanyName", "Foundry Telemetry Test Publisher\r\n"
            VALUE "ProductVersion", "9.8.7"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200, 0x040c, 1200
    END
END
